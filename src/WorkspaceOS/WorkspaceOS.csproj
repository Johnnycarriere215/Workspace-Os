<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WorkspaceOS</AssemblyName>
    <RootNamespace>WorkspaceOS</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>WorkspaceOS</Authors>
    <Product>WorkspaceOS</Product>
    <Description>A Linux-style productivity desktop environment layer for Windows 10.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained Condition="'$(Configuration)'=='Release'">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
