<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WorkspaceOS</AssemblyName>
    <RootNamespace>WorkspaceOS</RootNamespace>
    <Version>2.0.1</Version>
    <Authors>WorkspaceOS</Authors>
    <Product>WorkspaceOS</Product>
    <Description>A Hyprland-inspired workspace manager and tiling window manager for Windows 10/11.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained Condition="'$(Configuration)'=='Release'">true</SelfContained>
    <!-- Allows compiling on non-Windows dev boxes / CI (must still RUN on Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
