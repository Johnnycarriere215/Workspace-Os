<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WorkspaceOS dark theme — Pokémon/Charizard palette from the user's
         Omarchy setup (colors.toml): navy surfaces, cream text, muted steel
         secondary, gold accent, red as the energetic highlight. -->
    <SolidColorBrush x:Key="Bg" Color="#FF0F2138"/>
    <SolidColorBrush x:Key="BgPanel" Color="#FF142C4A"/>
    <SolidColorBrush x:Key="BgHover" Color="#FF1D3A5C"/>
    <SolidColorBrush x:Key="Fg" Color="#FFFDF4C4"/>
    <SolidColorBrush x:Key="FgDim" Color="#FF7893B4"/>
    <SolidColorBrush x:Key="Accent" Color="#FFCEBD7C"/>
    <SolidColorBrush x:Key="AccentDim" Color="#FF8A7550"/>
    <SolidColorBrush x:Key="Good" Color="#FF76C276"/>
    <SolidColorBrush x:Key="Bad" Color="#FFC56363"/>
    <SolidColorBrush x:Key="Border" Color="#FF2A4A6E"/>

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
    </Style>

    <Style TargetType="Button" x:Key="FlatButton">
        <Setter Property="Background" Value="{StaticResource BgPanel}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgPanel}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
    </Style>

    <Style x:Key="DarkList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

</ResourceDictionary>
