<Window x:Class="WorkspaceOS.UI.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkspaceOS — System Monitor" Width="720" Height="560"
        Background="#0A0A0A" WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SYSTEM MONITOR" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                   Foreground="#FFD75F" Margin="0,0,0,10"/>

        <UniformGrid Grid.Row="1" x:Name="CardsGrid" Columns="3" Margin="0,0,0,10"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="TOP PROCESSES" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                       Foreground="#8A8A8A" Margin="0,4,0,4"/>
            <ListView Grid.Row="1" x:Name="ProcessList" Background="#141414" BorderThickness="0"
                      Foreground="#E0E0E0" FontFamily="Consolas">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Process" Width="300" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="PID" Width="90" DisplayMemberBinding="{Binding Pid}"/>
                        <GridViewColumn Header="CPU %" Width="110" DisplayMemberBinding="{Binding CpuPercent}"/>
                        <GridViewColumn Header="Memory MB" Width="130" DisplayMemberBinding="{Binding MemoryMB}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
