<Window x:Class="WorkspaceOS.UI.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkspaceOS — System Monitor" Width="760" Height="600"
        Background="#FF05080A" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="#FFE8F8F5">
    <Window.Resources>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="#FF081012" BorderBrush="{StaticResource Border}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="SYSTEM MONITOR" FontFamily="{StaticResource UiFont}" FontSize="15"
                       FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
            <TextBlock Text="live" FontFamily="{StaticResource UiFont}" FontSize="10"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" x:Name="CardsGrid" Columns="3" Margin="0,0,0,14"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="TOP PROCESSES" Style="{StaticResource SectionText}" Margin="0,0,0,6"/>
            <ListView Grid.Row="1" x:Name="ProcessList" Background="Transparent" BorderBrush="{StaticResource Border}"
                      BorderThickness="1" Foreground="{StaticResource Fg}" FontFamily="{StaticResource UiFont}"
                      FontSize="11.5" ItemContainerStyle="{StaticResource DarkListViewItem}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Process" Width="320" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="PID" Width="90" DisplayMemberBinding="{Binding Pid}"/>
                        <GridViewColumn Header="CPU %" Width="110" DisplayMemberBinding="{Binding CpuPercent}"/>
                        <GridViewColumn Header="Memory MB" Width="130" DisplayMemberBinding="{Binding MemoryMB}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
