<Window x:Class="WorkspaceOS.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkspaceOS — Settings" Width="780" Height="600"
        Background="#0A0A0A" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,7" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" TextBlock.FontFamily="Consolas"
                                              TextBlock.Foreground="#8A8A8A"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141414"/>
                                <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="#FFD75F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
            <TabItem Header="Appearance"><ScrollViewer><StackPanel x:Name="AppearancePanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Workspaces"><ScrollViewer><StackPanel x:Name="WorkspacesPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Rules"><Grid x:Name="RulesPanel" Margin="14"/></TabItem>
            <TabItem Header="Hotkeys"><ScrollViewer><StackPanel x:Name="HotkeysPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Top Bar"><ScrollViewer><StackPanel x:Name="BarPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Focus Mode"><ScrollViewer><StackPanel x:Name="FocusPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Advanced"><ScrollViewer><StackPanel x:Name="AdvancedPanel" Margin="14"/></ScrollViewer></TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" FontFamily="Consolas" Foreground="#7CE38B" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Apply &amp; Save" Style="{StaticResource AccentButton}" Width="130" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
