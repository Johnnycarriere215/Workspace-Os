<Window x:Class="WorkspaceOS.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkspaceOS — Settings" Width="820" Height="640"
        Background="#FF0F2138" WindowStartupLocation="CenterScreen">
    <!-- Restyled after the user's custom Quickshell bar: navy surfaces,
         rounded bordered panel card, gold accents, JetBrainsMono text. -->
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="14,7" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              TextBlock.FontFamily="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"
                                              TextBlock.Foreground="#FF7893B4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF142C4A"/>
                                <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="#FFCEBD7C"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="#FFFDF4C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
            <Setter Property="Foreground" Value="#FFFDF4C4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- Implicit styles: every programmatically-created control follows the palette -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF0F2138"/>
            <Setter Property="Foreground" Value="#FFFDF4C4"/>
            <Setter Property="CaretBrush" Value="#FFCEBD7C"/>
            <Setter Property="BorderBrush" Value="#FF434F57"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFDF4C4"/>
            <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF0F2138"/>
            <Setter Property="Foreground" Value="#FFFDF4C4"/>
            <Setter Property="BorderBrush" Value="#FF434F57"/>
            <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1D3A5C"/>
            <Setter Property="Foreground" Value="#FFFDF4C4"/>
            <Setter Property="BorderBrush" Value="#FF434F57"/>
            <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- One rounded, bordered panel — the Quickshell popover shape -->
        <Border Grid.RowSpan="2" Background="#FF142C4A" BorderBrush="#FF434F57" BorderThickness="1" CornerRadius="6"/>
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Margin="8">
            <TabItem Header="Appearance"><ScrollViewer><StackPanel x:Name="AppearancePanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Workspaces"><ScrollViewer><StackPanel x:Name="WorkspacesPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Rules"><Grid x:Name="RulesPanel" Margin="14"/></TabItem>
            <TabItem Header="Tiling"><ScrollViewer><StackPanel x:Name="TilingPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Hotkeys"><ScrollViewer><StackPanel x:Name="HotkeysPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Top Bar"><ScrollViewer><StackPanel x:Name="BarPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Focus Mode"><ScrollViewer><StackPanel x:Name="FocusPanel" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="Advanced"><ScrollViewer><StackPanel x:Name="AdvancedPanel" Margin="14"/></ScrollViewer></TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,8,0">
            <TextBlock x:Name="StatusText" FontFamily="JetBrainsMono Nerd Font, Cascadia Mono, Consolas"
                       Foreground="#FF76C276" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Apply &amp; Save" Style="{StaticResource AccentButton}" Width="130" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
