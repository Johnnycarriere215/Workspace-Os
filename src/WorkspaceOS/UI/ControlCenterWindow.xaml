<Window x:Class="WorkspaceOS.UI.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Center" WindowStyle="None" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" Background="Transparent"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- The stock WPF button chrome is a light system control with a blue
             hover; on the Shibumi panel it reads as pasted on. This template
             keeps the theme fill and only dims it on hover/press. -->
        <Style x:Key="CcButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Shell" CornerRadius="12" Padding="14" BorderThickness="1" Margin="0,0,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.5" Color="#FF000000"/>
        </Border.Effect>
        <StackPanel Width="300">
            <DockPanel>
                <TextBlock x:Name="Heading" Text="CONTROL CENTER" FontSize="10" FontWeight="Bold"/>
                <Button x:Name="CloseButton" Content="✕" HorizontalAlignment="Right" Margin="8,0,0,0"
                        Padding="6,1" FontSize="11" BorderThickness="0" Background="Transparent"
                        Click="CloseButton_Click" AutomationProperties.Name="Close"/>
                <TextBlock x:Name="ClockText" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock x:Name="DateText" FontSize="11" Margin="0,3,0,14"/>

            <DockPanel Margin="0,0,0,2">
                <TextBlock x:Name="VolumeLabel" Text="VOLUME" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="VolumeValue" HorizontalAlignment="Right" FontSize="11"/>
            </DockPanel>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                    IsMoveToPointEnabled="True" ValueChanged="VolumeSlider_ValueChanged"/>
            <Button x:Name="MuteButton" Content="Mute" Margin="0,8,0,0" Padding="12,5"
                    HorizontalAlignment="Left" Style="{StaticResource CcButton}"
                    Click="MuteButton_Click"/>

            <UniformGrid Columns="2" Margin="0,16,0,0">
                <Border x:Name="CpuTile" CornerRadius="12" Padding="11,9" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="CpuValue" FontSize="19" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border x:Name="RamTile" CornerRadius="12" Padding="11,9" Margin="4,0,0,4">
                    <StackPanel>
                        <TextBlock Text="MEMORY" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="RamValue" FontSize="19" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border x:Name="DownTile" CornerRadius="12" Padding="11,9" Margin="0,4,4,0">
                    <StackPanel>
                        <TextBlock Text="DOWNLOAD" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="DownValue" FontSize="15"/>
                    </StackPanel>
                </Border>
                <Border x:Name="UpTile" CornerRadius="12" Padding="11,9" Margin="4,4,0,0">
                    <StackPanel>
                        <TextBlock Text="UPLOAD" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="UpValue" FontSize="15"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="WINDOWS" FontSize="9" FontWeight="Bold" Margin="0,16,0,6"/>
            <WrapPanel x:Name="ActionPanel">
                <Button x:Name="LockButton" Content="Lock" Margin="0,0,6,6" Padding="12,6" Style="{StaticResource CcButton}" Click="LockButton_Click"/>
                <Button x:Name="SettingsButton" Content="Settings" Margin="0,0,6,6" Padding="12,6" Style="{StaticResource CcButton}" Click="SettingsButton_Click"/>
                <Button x:Name="TasksButton" Content="Task Manager" Margin="0,0,6,6" Padding="12,6" Style="{StaticResource CcButton}" Click="TasksButton_Click"/>
                <Button x:Name="ThemeButton" Content="Next theme" Margin="0,0,6,6" Padding="12,6" Style="{StaticResource CcButton}" Click="ThemeButton_Click"/>
                <Button x:Name="BluetoothButton" Content="Bluetooth" Margin="0,0,6,6" Padding="12,6" Style="{StaticResource CcButton}" Click="BluetoothButton_Click"/>
                <Button x:Name="DisplayButton" Content="Display" Margin="0,0,6,6" Padding="12,6" Style="{StaticResource CcButton}" Click="DisplayButton_Click"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
