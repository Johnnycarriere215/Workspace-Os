<Window x:Class="WorkspaceOS.UI.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard" Width="500" Height="520"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        WindowStartupLocation="CenterScreen" Deactivated="Window_Deactivated"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Background="#F205080A" BorderBrush="#FF12413D" BorderThickness="1"
            CornerRadius="4" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.45" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="2,0,2,8">
                <TextBlock Text="CLIPBOARD" Style="{StaticResource SectionText}" VerticalAlignment="Center"/>
                <TextBlock Text="Enter copy · P pin · Del remove" FontFamily="{StaticResource UiFont}" FontSize="10"
                           Foreground="{StaticResource FgFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox Grid.Row="1" x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="9,6"
                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="List_KeyDown"/>
            <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource BorderSoft}" Margin="0,10,0,4"/>
            <ListBox Grid.Row="3" x:Name="ItemList" Style="{StaticResource DarkList}" Margin="0,4,0,0"
                     PreviewKeyDown="List_KeyDown" MouseDoubleClick="ItemList_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#FFE8F8F5"
                                       FontFamily="{StaticResource UiFont}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding PinMark}" FontSize="12" Foreground="#FF00E0CF"
                                       FontFamily="{StaticResource UiFont}" Margin="10,0,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
