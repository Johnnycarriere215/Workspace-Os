<Window x:Class="WorkspaceOS.UI.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkspaceOS Bar"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="False" Topmost="True" ShowActivated="False"
        Background="Black">
    <Grid x:Name="Root" Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: workspaces -->
        <StackPanel x:Name="WorkspacePanel" Grid.Column="0" Orientation="Horizontal" Margin="6,0,0,0"/>

        <!-- Center: clock -->
        <TextBlock x:Name="ClockText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="Consolas" FontSize="13" Foreground="#E0E0E0"/>

        <!-- Right: modules + buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
            <StackPanel x:Name="ModulePanel" Orientation="Horizontal"/>
            <Button x:Name="MonitorBtn" Content="&#9636;" ToolTip="System Monitor" Click="MonitorBtn_Click"
                    Background="Transparent" Foreground="#FFD75F" BorderThickness="0" FontSize="14"
                    Padding="8,0" Cursor="Hand" Focusable="False"/>
            <Button x:Name="SettingsBtn" Content="&#9881;" ToolTip="Settings" Click="SettingsBtn_Click"
                    Background="Transparent" Foreground="#FFD75F" BorderThickness="0" FontSize="14"
                    Padding="8,0" Cursor="Hand" Focusable="False"/>
        </StackPanel>
    </Grid>
</Window>
