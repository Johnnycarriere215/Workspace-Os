<Window x:Class="WorkspaceOS.UI.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkspaceOS Bar"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="Transparent">
    <!-- One continuous surface. Every colour is written by ApplyConfig from the
         active Omarchy theme, so the XAML carries geometry only. -->
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="BarSurface" Background="#D2121212" CornerRadius="0" Margin="0,0,0,0"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: workspaces. In the Shibumi form each dock sits on its own
                     island (own background, radius, inset); the other forms leave
                     the islands transparent so the surface stays one strip. -->
                <Border x:Name="LeftIsland" Grid.Column="0" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Background="Transparent" Padding="0"
                        CornerRadius="0">
                <StackPanel x:Name="LeftDock" Orientation="Horizontal"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                    <!-- Shibumi G1 sits before the workspaces: the mark opens the
                         shell menu, then G2 workspaces and the left widgets follow. -->
                    <Border x:Name="LogoBorder" CornerRadius="7" Margin="0,0,4,0" Padding="1"
                            Background="Transparent" VerticalAlignment="Center">
                        <Button x:Name="LogoButton" Style="{StaticResource BarButton}"
                                Padding="4,2" ToolTip="Bar menu — bar form, themes, logos"
                                AutomationProperties.Name="Bar menu"
                                Click="LogoButton_Click">
                            <Viewbox x:Name="BarIconView" Width="84" Height="20"
                                     Stretch="Uniform"
                                     RenderOptions.BitmapScalingMode="HighQuality">
                                <Canvas x:Name="BarIconCanvas" Width="100" Height="24"/>
                            </Viewbox>
                        </Button>
                    </Border>
                    <Grid x:Name="WorkspaceHost" VerticalAlignment="Center">
                        <Border x:Name="ActivePill" CornerRadius="6"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                IsHitTestVisible="False" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ActivePillTransform"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel x:Name="WorkspacePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="LeftModulePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                </StackPanel>
                </Border>

                <!-- Centre: clock, then the cava bars -->
                <Border x:Name="CenterIsland" Grid.Column="0" Grid.ColumnSpan="3"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent" Padding="0" CornerRadius="0">
                <StackPanel x:Name="CenterDock"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <!-- Shibumi G8: the clock sits in its own pill so the centre
                         reads as a group, not as floating text. -->
                    <Border x:Name="CenterPill" CornerRadius="12" Padding="10,3"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock x:Name="ClockText" VerticalAlignment="Center"
                                   FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                                   Background="Transparent" Cursor="Hand"
                                   TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Display"/>
                    </Border>
                    <Canvas x:Name="CavaCanvas" Width="0" Height="16" Margin="12,0,0,0"
                            VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False"/>
                </StackPanel>
                </Border>

                <!-- Right: modules, control center, then the logo menu -->
                <Border x:Name="RightIsland" Grid.Column="2" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Background="Transparent" Padding="0"
                        CornerRadius="0">
                <StackPanel x:Name="RightDock" Orientation="Horizontal"
                            Margin="0,0,6,0" VerticalAlignment="Center">
                    <StackPanel x:Name="ModulePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <!-- A 24 px square so the hover pill is centred on the glyph,
                         instead of a padded box that drifts with the font metrics. -->
                    <Button x:Name="ControlCenterButton" Style="{StaticResource BarButton}"
                            Width="24" Height="24" Padding="0" Margin="10,0,0,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip="Control Center" AutomationProperties.Name="Control Center"
                            Click="ControlCenterButton_Click">
                        <TextBlock x:Name="ControlCenterGlyph" Text="⏻" FontSize="12.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Button>
                </StackPanel>
                </Border>

                <!-- Hairline: the theme's separator colour -->
                <Rectangle x:Name="BarHairline" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Bar menu: forms, themes, logos, actions (built in code) -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=LogoButton}"
               Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
               HorizontalOffset="-260">
            <Border x:Name="MenuBorder" CornerRadius="10" Padding="12" Margin="0,8,0,0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.5" Color="#FF000000"/>
                </Border.Effect>
                <StackPanel x:Name="MenuHost" Width="292"/>
            </Border>
        </Popup>

        <!-- Calendar popover (stays open; TopBarWindow dismisses it on outside clicks) -->
        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=ClockText}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border x:Name="CalendarBorder" CornerRadius="8" Padding="14,11" Margin="0,7,0,0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#FF000000"/>
                </Border.Effect>
                <StackPanel x:Name="CalendarHost"/>
            </Border>
        </Popup>
    </Grid>
</Window>
