<Window x:Class="WorkspaceOS.UI.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkspaceOS Bar"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#FF05080A">
    <!-- Geometry Dash theme: void-black space, electric cyan energy, white ink.
         One continuous surface, chunky 3px edges, a neon active slot, and a
         stylised fish mark + spike row echoing the wallpaper's GD icon. -->
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF7FE6DD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF122427"/>
                                <Setter Property="Foreground" Value="#FFE8F8F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4400E0CF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF040708" Offset="0"/>
                <GradientStop Color="#FF07110F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Geometry Dash fish mark, then workspace chips over the neon pill -->
        <StackPanel x:Name="LeftDock" Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
            <Viewbox Width="30" Height="17" Margin="1,0,10,0" VerticalAlignment="Center"
                     ToolTip="Geometry Dash">
                <Canvas Width="46" Height="24">
                    <!-- Cyan energy silhouette + glow -->
                    <Path Data="M 12,4 L 31,4 L 43,12 L 31,20 L 12,20 L 4,12 Z"
                          Stroke="#FF00E0CF" StrokeThickness="3.4" StrokeLineJoin="Round">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.7" Color="#FF00E0CF"/>
                        </Path.Effect>
                    </Path>
                    <!-- White icon body with the wallpaper's hard black outline -->
                    <Path Data="M 12,4 L 31,4 L 43,12 L 31,20 L 12,20 L 4,12 Z"
                          Fill="#FFF2FFFD" Stroke="#FF04100F" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                    <Path Data="M 12,4 L 3,0 L 6,12 L 3,24 L 12,20 Z"
                          Fill="#FFF2FFFD" Stroke="#FF04100F" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                    <Path Data="M 43,12 L 36,9.6 L 36,14.4 Z" Fill="#FF04100F"/>
                    <Ellipse Canvas.Left="31.5" Canvas.Top="8" Width="4.2" Height="4.2"
                             Fill="#FF04100F" Stroke="#FF00E0CF" StrokeThickness="0.9"/>
                </Canvas>
            </Viewbox>

            <Grid x:Name="WorkspaceHost" VerticalAlignment="Center">
                <Border x:Name="ActivePill" Background="#FF00E0CF" CornerRadius="3"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsHitTestVisible="False" Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#FF00E0CF"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ActivePillTransform"/>
                    </Border.RenderTransform>
                </Border>
                <StackPanel x:Name="WorkspacePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Center: clock (click → calendar) -->
        <TextBlock x:Name="ClockText" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                   Background="Transparent"
                   Foreground="#FFE8F8F5" Cursor="Hand" MouseLeftButtonUp="ClockText_Click"
                   TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Display">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.35" Color="#FF00E0CF"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Right: GD spikes, modules, then monitor + settings chips -->
        <StackPanel x:Name="RightDock" Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,3,0" Opacity="0.85"
                        IsHitTestVisible="False">
                <Path Data="M 0,9 L 4,1 L 8,9 Z" Fill="#FF0C8F88" Margin="0,0,2,0"/>
                <Path Data="M 0,9 L 4,1 L 8,9 Z" Fill="#FF00E0CF"/>
                <Path Data="M 0,9 L 4,1 L 8,9 Z" Fill="#FF0C8F88" Margin="2,0,0,0"/>
            </StackPanel>

            <StackPanel x:Name="ModulePanel" Orientation="Horizontal" VerticalAlignment="Center"/>

            <!-- Vector icons: no font coverage to rely on, so they can never render as tofu -->
            <Border Background="#FF081012" BorderBrush="#FF123A37" BorderThickness="1"
                    CornerRadius="3" Margin="6,3,3,3" Padding="0" VerticalAlignment="Center">
                <Button x:Name="MonitorBtn" ToolTip="Display settings"
                        AutomationProperties.Name="Display settings"
                        Foreground="#FF7FE6DD" Click="DisplaySettingsBtn_Click" Style="{StaticResource BarButton}"
                        Padding="7,4">
                    <Canvas Width="15" Height="13">
                        <Path Data="M 1,1 L 14,1 L 14,9 L 1,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"/>
                        <Path Data="M 5,12 L 10,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"/>
                    </Canvas>
                </Button>
            </Border>
            <Border Background="#FF081012" BorderBrush="#FF123A37" BorderThickness="1"
                    CornerRadius="3" Margin="3,3,0,3" Padding="0" VerticalAlignment="Center">
                <Button x:Name="SettingsBtn" ToolTip="Task Manager"
                        AutomationProperties.Name="Task Manager"
                        Foreground="#FF7FE6DD" Click="TaskManagerBtn_Click" Style="{StaticResource BarButton}"
                        Padding="7,4">
                    <Canvas Width="15" Height="13">
                        <Path Data="M 1,3 L 14,3 M 1,10 L 14,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"/>
                        <Ellipse Width="4" Height="4" Canvas.Left="4" Canvas.Top="1"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="8"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Canvas>
                </Button>
            </Border>
        </StackPanel>

        <!-- Energy edge: a teal hairline with a faint cyan bloom -->
        <Rectangle x:Name="BarHairline" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                   Fill="#FF0E4A45" IsHitTestVisible="False"/>
        <Rectangle Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1" Fill="#FF00E0CF"
                   Opacity="0.22" IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.8" Color="#FF00E0CF"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- Calendar popover -->
        <!-- StaysOpen=True: the bar never takes focus, so WPF's own outside-click
             auto-close is unreliable. TopBarWindow's mouse hook dismisses it. -->
        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=ClockText}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border CornerRadius="6" Padding="14,11" Margin="0,7,0,0" Background="#FF071012"
                    BorderBrush="#FF12413D" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#FF000000"/>
                </Border.Effect>
                <StackPanel x:Name="CalendarHost"/>
            </Border>
        </Popup>
    </Grid>
</Window>
