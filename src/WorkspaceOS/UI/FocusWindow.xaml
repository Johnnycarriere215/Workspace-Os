<Window x:Class="WorkspaceOS.UI.FocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Mode" Width="480" Height="430"
        Background="#FF05080A" WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="#FFE8F8F5">
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{StaticResource BgRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <!-- Setup -->
        <StackPanel x:Name="SetupPanel" VerticalAlignment="Center">
            <TextBlock Text="FOCUS MODE" FontFamily="{StaticResource UiFont}" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource Fg}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="One session. No blocked apps." FontFamily="{StaticResource UiFont}" FontSize="11"
                       Foreground="{StaticResource FgDim}" HorizontalAlignment="Center" Margin="0,0,0,22"/>
            <TextBlock Text="Session length (minutes)" FontFamily="{StaticResource UiFont}" FontSize="11"
                       Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
            <TextBox x:Name="DurationBox" Width="112" Margin="0,8,0,14" TextAlignment="Center"
                     Style="{StaticResource DarkTextBox}" FontSize="19"/>
            <StackPanel x:Name="PresetPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="Start focus" Style="{StaticResource AccentButton}" Width="170" Height="34"
                    FontSize="13" Click="Start_Click"/>
            <TextBlock x:Name="BlockedInfo" FontFamily="{StaticResource UiFont}" FontSize="10.5"
                       Foreground="{StaticResource FgFaint}" HorizontalAlignment="Center" Margin="0,16,0,0"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <!-- Active -->
        <StackPanel x:Name="ActivePanel" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="FOCUSING" FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CountdownText" Text="25:00" FontFamily="{StaticResource UiFont}" FontSize="62"
                       FontWeight="SemiBold" Foreground="{StaticResource Fg}" HorizontalAlignment="Center"
                       Margin="0,6,0,14"/>
            <ProgressBar x:Name="FocusProgress" Width="330" Margin="0,0,0,10"/>
            <TextBlock x:Name="ProgressLabel" FontFamily="{StaticResource UiFont}" FontSize="11"
                       Foreground="{StaticResource FgDim}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <Button Content="Abort" Style="{StaticResource FlatButton}" Width="130" Click="Abort_Click"/>
        </StackPanel>

        <!-- Failure -->
        <StackPanel x:Name="FailPanel" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="GOAL NOT MET" FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock x:Name="FailDetails" FontFamily="{StaticResource UiFont}" FontSize="12"
                       Foreground="{StaticResource Fg}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,0,22" LineHeight="19"/>
            <Button Content="Return to setup" Style="{StaticResource FlatButton}" Width="160" Click="Reset_Click"/>
        </StackPanel>

        <!-- Success -->
        <StackPanel x:Name="SuccessPanel" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="CelebrationText" Text="FOCUS COMPLETE" FontFamily="{StaticResource UiFont}"
                       FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Good}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="SuccessDetails" FontFamily="{StaticResource UiFont}" FontSize="12"
                       Foreground="{StaticResource Fg}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="19"/>
            <TextBlock Text="RECENT SESSIONS" Style="{StaticResource SectionText}"
                       HorizontalAlignment="Center" Margin="0,6,0,6"/>
            <ItemsControl x:Name="HistoryList" HorizontalAlignment="Center" MaxHeight="110"/>
            <Button Content="Done" Style="{StaticResource AccentButton}" Width="120" Margin="0,18,0,0" Click="Reset_Click"/>
        </StackPanel>
    </Grid>
</Window>
